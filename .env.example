# ---------------------------------------------------------------------------
# Copy to .env and fill in. Never commit the real .env.
# ---------------------------------------------------------------------------

# --- LLM provider -----------------------------------------------------------
# Groq API key: https://console.groq.com/keys
GROQ_API_KEY=gsk_your_key_here

# Model used by the pipeline. Overridable so evals can compare models.
LLM_MODEL=llama-3.1-8b-instant

# Prompt version the pipeline runs. Part of the cache key, so bumping this
# invalidates cached results instead of serving stale analyses.
PROMPT_VERSION=v4

# --- Database ---------------------------------------------------------------
# PostgreSQL. Free managed Postgres: https://neon.tech (no card, wakes on demand).
# Copy the connection string from the Neon dashboard; it already includes
# ?sslmode=require. This value is a password — never commit it.
DATABASE_URL="postgresql://user:password@host.neon.tech/neondb?sslmode=require"

# To work offline on SQLite instead: set provider = "sqlite" in
# backend/prisma/schema.prisma, use DATABASE_URL="file:./dev.db", and regenerate
# migrations. Every column type in the schema exists on both engines, so nothing
# else changes.

# --- API --------------------------------------------------------------------
PORT=5000
NODE_ENV=development
LOG_LEVEL=info

# Comma-separated list of browser origins allowed to call the API.
CORS_ORIGINS=http://localhost:5173

# Abuse limits on the LLM-backed upload endpoint.
UPLOAD_RATE_LIMIT_PER_HOUR=10
MAX_TRANSCRIPT_CHARS=20000

# Whether this process also serves the built dashboard.
#   auto (default) — serves it in production when frontend/dist exists
#   on             — force it (one port serves dashboard + API)
#   off            — API only, the split Render + Vercel shape
# When the dashboard is served here, the API moves under /api so that the
# dashboard owns /calls/:id. Leave this alone unless you are deploying.
SERVE_WEB=auto

# --- Web (Vite; only VITE_-prefixed vars reach the browser) -----------------
# Left unset on purpose. Unset means the dashboard calls "/api", which the Vite
# dev server proxies to the backend — same-origin in development, so CORS is
# exercised only in the deployed configuration.
#
# Set it when the dashboard is deployed apart from the API (Vercel + Render):
#   VITE_API_URL=https://your-api.onrender.com
# Vite reads this file because vite.config.ts sets envDir to the repo root.
# VITE_API_URL=
