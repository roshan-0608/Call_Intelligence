{
  "name": "@call-intel/backend",
  "version": "2.0.0",
  "description": "Express + Prisma API serving analyzed calls, leaderboard, analytics and transcript upload.",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../.env src/index.ts",
    "build": "tsc -b",
    "start": "node --env-file-if-exists=../.env dist/index.js",
    "clean": "rm -rf dist *.tsbuildinfo"
  },
  "//": "Prisma/DB scripts live in the root package.json so the CLI runs with the repo root as cwd and picks up the single root .env.",
  "dependencies": {
    "@call-intel/shared": "*",
    "@prisma/client": "^6.1.0",
    "compression": "^1.7.5",
    "cors": "^2.8.5",
    "express": "^5.0.1",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.0.0",
    "pino": "^9.5.0",
    "pino-http": "^10.3.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/compression": "^1.7.5",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/supertest": "^6.0.2",
    "pino-pretty": "^13.0.0",
    "prisma": "^6.1.0",
    "supertest": "^7.0.0"
  }
}
